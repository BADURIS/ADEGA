# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin / Service Role (Usado em Server API e Webhooks - Sem Fallback)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago & Automações
MERCADO_PAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Segredo de Autenticação para Webhooks Internos (Stock Alert)
INTERNAL_WEBHOOK_SECRET=your-internal-webhook-secret

# Número de WhatsApp do Administrador para Alertas
ADMIN_WHATSAPP_NUMBER=5513997650605

# Upstash Redis HTTP API (Opcional - Rate Limiting Distribuído em Produção)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
